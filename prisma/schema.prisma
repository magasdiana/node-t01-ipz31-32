generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Room {
  id     Int     @id @default(autoincrement())
  data   Json    // назва, cost
  groups Group[]

  @@map("rooms")
}

model Group {
  id       Int      @id @default(autoincrement())
  roomId   Int?     @map("room_id")
  data     Json     // вік, ліміт
  room     Room?    @relation(fields: [roomId], references: [id])
  children Child[]
  staff    Staff[]
  lessons  Lesson[]

  @@map("groups")
}

model Child {
  id       Int       @id @default(autoincrement())
  groupId  Int?      @map("group_id")
  data     Json      // ім'я, дата народження, батьки (3), родич-депутат, вподобання, пільга
  group    Group?    @relation(fields: [groupId], references: [id])
  payments Payment[]

  @@map("children")
}

model Staff {
  id            Int            @id @default(autoincrement())
  groupId       Int?           @map("group_id") // вихователь і помічник належать групі
  data          Json           // ПІБ, посада, зарплата
  group         Group?         @relation(fields: [groupId], references: [id])
  staffSubjects StaffSubject[]
  lessons       Lesson[]

  @@map("staff")
}

model Subject {
  id            Int            @id @default(autoincrement())
  data          Json           // назва гуртка
  staffSubjects StaffSubject[]
  lessons       Lesson[]

  @@map("subjects")
}

model StaffSubject {
  id        Int     @id @default(autoincrement())
  staffId   Int     @map("staff_id")
  subjectId Int     @map("subject_id")
  staff     Staff   @relation(fields: [staffId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([staffId, subjectId])
  @@map("staff_subjects")
}

model Lesson {
  id        Int     @id @default(autoincrement())
  groupId   Int     @map("group_id")
  subjectId Int     @map("subject_id")
  staffId   Int     @map("staff_id")
  data      Json    // день, час початку, тривалість
  group     Group   @relation(fields: [groupId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  staff     Staff   @relation(fields: [staffId], references: [id])

  @@map("lessons")
}

model Payment {
  id      Int   @id @default(autoincrement())
  childId Int   @map("child_id")
  data    Json  // сума, знижки, період, дата
  child   Child @relation(fields: [childId], references: [id])

  @@map("payments")
}

model PriceSettings {
  id   Int  @id @default(autoincrement())
  data Json // поточні ціни: навчання, харчування за віком, пільги, річна знижка

  @@map("price_settings")
}

model PriceHistory {
  id   Int  @id @default(autoincrement())
  data Json // старі значення, дата, хто змінив. Без FK за рішенням

  @@map("price_history")
}