  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "Login Admin (save JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', data.token);",
                  "pm.test('Admin token received', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
                  "pm.test('passwordHash is not exposed', function () { pm.expect(pm.response.text()).not.to.include('passwordHash'); });"
                ]
              }
            }
          ]
        },
