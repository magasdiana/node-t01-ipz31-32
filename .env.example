# Підключення до PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/garden?schema=public"

PORT=3000
NODE_ENV=development

JWT_SECRET=local_test_secret_key_2026
# Термін дії токена (формат jsonwebtoken: 15m, 8h, 7d)
JWT_EXPIRES_IN=8h
# true за замовчуванням. false працює лише поза production (для тестів без токена).
# У production (NODE_ENV=production) авторизація завжди увімкнена.
AUTH_ENABLED=true
